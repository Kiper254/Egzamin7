<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="WlasciwosciCzcionki.MainPage"
    Shell.NavBarIsVisible="False"
    BackgroundColor="White">

    <VerticalStackLayout
        Margin="20"
        Spacing="12"
        HorizontalOptions="Fill">

        <Label
            Text="Właściwości czcionki"
            FontSize="26"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#558B2F"
            HorizontalOptions="Fill" />

        <Label
            x:Name="RozmiarLabel"
            Text="Rozmiar:"
            FontSize="18"
            TextColor="Black"
            HorizontalOptions="Fill" />

        <Slider
            x:Name="RozmiarSlider"
            Minimum="0"
            Maximum="40"
            Value="0"
            HorizontalOptions="Fill"
            ValueChanged="RozmiarSlider_ValueChanged" />

        <Label
            x:Name="CytatLabel"
            Text="Dzień dobry"
            FontSize="14"
            TextColor="Black"
            HorizontalOptions="Fill" />

        <Button
            Text="&gt;&gt;"
            FontAttributes="Bold"
            TextColor="White"
            BackgroundColor="#558B2F"
            CornerRadius="0"
            WidthRequest="110"
            HorizontalOptions="Center"
            Clicked="ZmienCytat_Clicked" />

    </VerticalStackLayout>

</ContentPage>